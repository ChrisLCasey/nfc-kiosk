{
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-src https://player.vimeo.com; default-src 'self' 'unsafe-inline' ws://localhost:8765"
        }
      ]
    }
  ]
}
